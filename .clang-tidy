# Pending lint follow-ups (enable one check per reviewed commit):
#   -bugprone-empty-catch (2 findings)
#   -bugprone-exception-escape (1 finding)
#   -bugprone-unchecked-optional-access (1 finding)
Checks: '-*,clang-analyzer-core.*,clang-analyzer-cplusplus.*,bugprone-*,-bugprone-easily-swappable-parameters,-bugprone-signed-bitwise,-bugprone-throwing-static-initialization,-bugprone-reserved-identifier,-bugprone-branch-clone,-bugprone-macro-parentheses,-bugprone-lambda-function-name,-bugprone-std-exception-baseclass,-bugprone-switch-missing-default-case,-bugprone-argument-comment,-bugprone-unintended-char-ostream-output,-bugprone-empty-catch,-bugprone-exception-escape,-bugprone-unchecked-optional-access'
WarningsAsErrors: '*'
HeaderFilterRegex: '[/\\](src|tests)[/\\]'
SystemHeaders: false
